<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.QCSR" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="ContainerNoAlpha">
        <item name="android:background">@drawable/rounded_corner_black_filled</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">80sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">@dimen/margin_block</item>
        <item name="android:layout_marginEnd">@dimen/margin_block</item>
    </style>

    <style name="ContainerNoNumeric">
        <item name="android:background">@drawable/rounded_corner_white_filled</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">70sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">@dimen/margin_block_small</item>
        <item name="android:layout_marginEnd">@dimen/margin_block_small</item>
    </style>

    <style name="LocationAlpha">
        <item name="android:background">@drawable/rounded_corner_black_filled</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">70sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAlignment">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginStart">@dimen/margin_block</item>
        <item name="android:layout_marginEnd">@dimen/margin_block</item>
    </style>

    <style name="LabelText">
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/darkest_gray</item>
        <item name="android:layout_marginStart">@dimen/margin_block</item>
        <item name="android:layout_marginEnd">@dimen/margin_block</item>
    </style>

    <style name="ValueText">
        <item name="android:background">@color/white</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:layout_marginStart">@dimen/margin_block</item>
        <item name="android:layout_marginEnd">@dimen/margin_block</item>
    </style>
</resources>